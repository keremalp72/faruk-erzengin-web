{
    "redirects": [
      {
        "source": "/:path(.*)",
        "has": [
          {
            "type": "host",
            "value": "www.farukerzengin.com"
          }
        ],
        "destination": "https://farukerzengin.com/:path",
        "permanent": true
      }
    ],
    "rewrites": [
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ]
  }